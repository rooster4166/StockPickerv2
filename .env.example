# --- LLM access ---------------------------------------------------------------
# The Anthropic SDK reads ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN) and,
# optionally, ANTHROPIC_BASE_URL from the environment. Set one of these.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- SEC EDGAR ----------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address on every request.
SEC_USER_AGENT=microcap-value-engine you@example.com

# --- Engine knobs (all optional; defaults live in microcap_engine/config.py) ---
# MCE_MCAP_MIN=50000000
# MCE_MCAP_MAX=300000000
# MCE_MARGIN_OF_SAFETY=0.30
# MCE_ENSEMBLE_N=3
# MCE_DEEP_MODEL=claude-opus-4-8
# MCE_REDTEAM_MODEL=claude-sonnet-4-6
