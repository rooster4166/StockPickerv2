# Copy to .env and fill in. .env is gitignored.

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Financial Modeling Prep API key — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (name + email)
SEC_USER_AGENT=Your Name your.email@example.com
